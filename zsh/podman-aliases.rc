alias pcu='podman-compose up'              # foreground, Ctrl-C stops the stack
alias pcd='podman-compose down'
alias pcl='podman-compose logs -f'
alias pcr='podman-compose restart'
alias pcb='podman-compose build'
alias pcp='podman-compose ps'

# the few raw-podman ones worth having
alias pps='podman ps'
alias ppa='podman ps -a'
alias plg='podman logs -f'
alias pxc='podman exec -it'   # `pex` collides with Python PEX tool

alias lzd='lazydocker'

function lzp {
  # lazydocker against the podman socket
  local sock
  case "$OSTYPE" in
    darwin*) sock=$(podman machine inspect --format '{{.ConnectionInfo.PodmanSocket.Path}}' 2>/dev/null) ;;
    linux*)  sock="${XDG_RUNTIME_DIR:-/run/user/$UID}/podman/podman.sock" ;;
  esac
  if [[ ! -S "$sock" ]]; then
    echo "podman socket not found at: $sock" >&2
    echo "  mac:   podman machine start" >&2
    echo "  linux: systemctl --user enable --now podman.socket" >&2
    return 1
  fi
  DOCKER_HOST="unix://$sock" lazydocker
}
