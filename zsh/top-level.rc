#!/bin/zsh

readonly SCRIPT_DIR=$(dirname $(readlink $HOME/.zshrc))/zsh
echo $SCRIPT_DIR

# --- 1. PATH first, so everything downstream sees a complete environment ---

# Cross-OS PATH additions. OS-specific entries live in mac-os.rc / linux.rc.
[[ -d $HOME/.local/bin ]] && export PATH="$PATH:$HOME/.local/bin"  # XDG-standard user bin
[[ -d $HOME/go/bin ]]     && export PATH="$PATH:$HOME/go/bin"      # `go install` output

# OS-specific config (PATH + env that varies by OS)
case "$OSTYPE" in
  darwin*) source $SCRIPT_DIR/mac-os.rc ;;
  linux*)  source $SCRIPT_DIR/linux.rc ;;
esac

# Per-host overrides. $HOST is zsh's built-in short hostname.
case "$HOST" in
  # example:
  # blue-heron)      export FOO=bar ;;
  # framework-linux) alias open='xdg-open' ;;
  *) ;;
esac

# --- 2. Framework init that wants a complete PATH ---
source $SCRIPT_DIR/oh-my-zsh.rc

# --- 3. Aliases (pure string defs, order-independent) ---
source $SCRIPT_DIR/git-aliases.rc
source $SCRIPT_DIR/docker-aliases.rc
source $SCRIPT_DIR/podman-aliases.rc
source $SCRIPT_DIR/other-aliases.rc

FZF_ALT_C_COMMAND=
FZF_CTRL_T_COMMAND=
FZF_CTRL_R_COMMAND=
#eval "$(fzf --zsh)"

# Remove bindings for ctrl+s, ctrl+r
bindkey -M emacs -r '^s'
bindkey -M vicmd -r '^s'
bindkey -M viins -r '^s'

bindkey -M emacs -r '^r'
bindkey -M vicmd -r '^r'
bindkey -M viins -r '^r'

# Add bindings for reverse search
# bindkey -M emacs '^sr' fzf-history-widget
# bindkey -M vicmd '^sr' fzf-history-widget
# bindkey -M viins '^sr' fzf-history-widget

# set less mode
export LESS=FRX
## From https://stackoverflow.com/questions/69091601/git-branch-displays-my-branch-names-in-a-vim-window-instead-of-in-my-current-it

# source $DOTFILES/fzf_completions.zsh
# source $DOTFILES/fzf_keybindings.zsh
# source $DOTFILES/fzf-docker/fzf-docker.plugin.zsh
source $SCRIPT_DIR/fzf-tab-completion/zsh/fzf-zsh-completion.sh
bindkey '^I' fzf_completion

export FZF_COMPLETION_TRIGGER=','
export FZF_DEFAULT_COMMAND='fd --type f'
# source /home/pragun/.config/broot/launcher/bash/br


source $SCRIPT_DIR/atuin-init.zsh
