# ls — color flag differs between BSD (mac) and GNU (linux)
case "$OSTYPE" in
  darwin*) alias ls='ls -G' ;;
  linux*)  alias ls='ls --color=auto' ;;
esac
alias ll='ls -lh'      # long, human-readable sizes
alias la='ls -lAh'     # long, all (incl. dotfiles), human
alias lr='ls -lhtr'    # sorted by mtime, newest at bottom (good for terminals)

alias yz='yazi'
alias lt='tree -C'

# Directory navigation + code opening aliases
# dc <dir> - cd to dir and open vscode
dc() {
    cd "$1" && code .
}

# dcn <dir> - open new wezterm tab, cd to dir, open vscode
dcn() {
    wezterm cli spawn --cwd "$1" -- zsh -c "cd '$1' && code . && exec zsh"
}

# dcng <dir> - same as dcn but also run lazygit
dcng() {
    wezterm cli spawn --cwd "$1" -- zsh -c "cd '$1' && code . && lazygit; exec zsh"
}

# dcg <dir> - cd to dir, open vscode, and run lazygit (no new tab)
dcg() {
    cd "$1" && code . && lg
}
